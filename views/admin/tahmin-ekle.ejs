<div class="admin-page">
    <div class="page-actions">
        <a href="/admin/tahminler" class="btn btn-secondary">← Geri</a>
    </div>

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Yeni Tahmin Ekle</h3>
        </div>
        <div class="card-body">
            <form action="/admin/tahminler/yeni" method="POST" class="admin-form">
                <div class="form-grid">
                    <div class="form-group full">
                        <label for="baslik">Başlık *</label>
                        <input type="text" id="baslik" name="baslik" placeholder="Tahmin başlığını yazın..." required>
                    </div>

                    <div class="form-group full">
                        <label for="aciklama">Açıklama</label>
                        <textarea id="aciklama" name="aciklama" rows="3" placeholder="Tahmin açıklaması..."></textarea>
                    </div>

                    <div class="form-group">
                        <label for="kategori_id">Kategori *</label>
                        <select id="kategori_id" name="kategori_id" required>
                            <option value="">Seçin...</option>
                            <% kategoriler.forEach(function(k) { %>
                                <option value="<%= k.id %>"><%= k.ikon %> <%= k.ad %></option>
                            <% }); %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="bi_odul">bi! Ödülü *</label>
                        <input type="number" id="bi_odul" name="bi_odul" value="100" min="10" max="10000" required>
                    </div>

                    <div class="form-group">
                        <label for="bitis_tarihi">Bitiş Tarihi *</label>
                        <input type="datetime-local" id="bitis_tarihi" name="bitis_tarihi" required>
                    </div>

                    <div class="form-group full">
                        <label for="gorsel">Görsel URL</label>
                        <input type="url" id="gorsel" name="gorsel" placeholder="https://example.com/image.jpg">
                    </div>

                    <div class="form-group">
                        <label class="checkbox-label">
                            <input type="checkbox" name="sponsorlu_mu" id="sponsorlu_mu">
                            <span>Sponsorlu Tahmin</span>
                        </label>
                    </div>

                    <div class="form-group" id="sponsorField" style="display: none;">
                        <label for="sponsor_adi">Sponsor Adı</label>
                        <input type="text" id="sponsor_adi" name="sponsor_adi" placeholder="Sponsor firma adı">
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Tahmin Ekle</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
document.getElementById('sponsorlu_mu').addEventListener('change', function() {
    document.getElementById('sponsorField').style.display = this.checked ? 'block' : 'none';
});
</script>
