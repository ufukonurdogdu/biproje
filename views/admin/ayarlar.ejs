                            </div>
                            <div class="form-group">
                                <label class="form-label">Destek E-postası</label>
                                <input type="email" class="form-input" name="support_email" value="destek@bilemezsin.com">
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <button type="submit" class="btn btn-primary">Değişiklikleri Kaydet</button>
                    </div>
                </div>
            </form>
        </div>

        <!-- bi! Coin Ayarları -->
        <div class="settings-section" id="bicoin" style="display: none;">
            <form action="/admin/ayarlar/bicoin" method="POST">
                <div class="settings-card">
                    <div class="card-header">
                        <div>
                            <h2 class="card-title">bi! Coin Ayarları</h2>
                            <p class="card-subtitle">Sanal para birimi ve ödül sistemi</p>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="stats-grid">
