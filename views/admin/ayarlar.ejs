                                <div class="stat-box-value">125.4M</div>
                                <div class="stat-box-label">Toplam bi! Coin</div>
                            </div>
                            <div class="stat-box">
                                <div class="stat-box-value">89.2M</div>
                                <div class="stat-box-label">Dolaşımda</div>
                            </div>
                            <div class="stat-box">
                                <div class="stat-box-value">36.2M</div>
                                <div class="stat-box-label">Havuzlarda</div>
