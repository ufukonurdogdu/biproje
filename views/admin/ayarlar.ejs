                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
            </svg>
            E-posta
        </a>
        <a class="nav-item" href="#bildirimler" onclick="showSection('bildirimler')">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
            </svg>
            Bildirimler
        </a>
        <a class="nav-item" href="#guvenlik" onclick="showSection('guvenlik')">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            Güvenlik
        </a>
        <a class="nav-item" href="#bakim" onclick="showSection('bakim')">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
            </svg>
            Bakım
        </a>
    </nav>

    <!-- Settings Content -->
    <div class="settings-content">
        <!-- Genel Ayarlar -->
        <div class="settings-section" id="genel">
            <form action="/admin/ayarlar/genel" method="POST" enctype="multipart/form-data">
                <div class="settings-card">
                    <div class="card-header">
                        <div>
                            <h2 class="card-title">Genel Ayarlar</h2>
                            <p class="card-subtitle">Site başlığı, logo ve temel bilgiler</p>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="form-group">
                            <label class="form-label">Site Adı</label>
                            <input type="text" class="form-input" name="site_name" value="<%= typeof settings !== 'undefined' ? settings.site_name : 'Bilemezsin' %>">
                        </div>
                        
                        <div class="form-group">
                            <label class="form-label">Site Açıklaması</label>
                            <textarea class="form-textarea" name="site_description"><%= typeof settings !== 'undefined' ? settings.site_description : 'Türkiyenin en eğlenceli tahmin platformu!' %></textarea>
                        </div>
                        
                        <div class="form-group">
                            <label class="form-label">Logo</label>
                            <div class="logo-upload">
                                <div class="logo-preview">bi!</div>
                                <div class="logo-actions">
