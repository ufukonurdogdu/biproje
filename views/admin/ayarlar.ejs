                                <div class="toggle-desc">Tahmin sonuçlandığında kullanıcıları bilgilendir</div>
                            </div>
                            <label class="toggle-switch">
                                <input type="checkbox" name="result_notification" checked>
                                <span class="toggle-slider"></span>
                            </label>
                        </div>
                        
                        <div class="toggle-group">
                            <div class="toggle-info">
                                <div class="toggle-title">Kazanç Bildirimi</div>
                                <div class="toggle-desc">Kullanıcılar kazandığında e-posta gönder</div>
                            </div>
                            <label class="toggle-switch">
                                <input type="checkbox" name="win_notification" checked>
                                <span class="toggle-slider"></span>
                            </label>
                        </div>
                        
                        <div class="toggle-group">
                            <div class="toggle-info">
                                <div class="toggle-title">Haftalık Özet</div>
                                <div class="toggle-desc">Kullanıcılara haftalık aktivite özeti gönder</div>
                            </div>
                            <label class="toggle-switch">
                                <input type="checkbox" name="weekly_summary">
                                <span class="toggle-slider"></span>
                            </label>
                        </div>
                        
                        <div class="toggle-group">
                            <div class="toggle-info">
                                <div class="toggle-title">Yeni Tahmin Bildirimi</div>
                                <div class="toggle-desc">Popüler tahminler için bildirim gönder</div>
                            </div>
                            <label class="toggle-switch">
                                <input type="checkbox" name="new_prediction_alert">
                                <span class="toggle-slider"></span>
                            </label>
                        </div>
                    </div>
                    <div class="card-footer">
                        <button type="submit" class="btn btn-primary">Değişiklikleri Kaydet</button>
                    </div>
                </div>
            </form>
        </div>

        <!-- Güvenlik Ayarları -->
        <div class="settings-section" id="guvenlik" style="display: none;">
            <form action="/admin/ayarlar/guvenlik" method="POST">
                <div class="settings-card">
                    <div class="card-header">
                        <div>
                            <h2 class="card-title">Güvenlik Ayarları</h2>
                            <p class="card-subtitle">Hesap güvenliği ve oturum ayarları</p>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="toggle-group">
                            <div class="toggle-info">
                                <div class="toggle-title">İki Faktörlü Doğrulama (Admin)</div>
                                <div class="toggle-desc">Admin girişlerinde 2FA zorunlu olsun</div>
                            </div>
                            <label class="toggle-switch">
                                <input type="checkbox" name="admin_2fa" checked>
                                <span class="toggle-slider"></span>
                            </label>
                        </div>
                        
                        <div class="toggle-group">
                            <div class="toggle-info">
                                <div class="toggle-title">E-posta Doğrulama</div>
                                <div class="toggle-desc">Yeni hesaplar için e-posta doğrulaması zorunlu olsun</div>
                            </div>
                            <label class="toggle-switch">
                                <input type="checkbox" name="email_verification" checked>
                                <span class="toggle-slider"></span>
                            </label>
                        </div>
                        
                        <div class="toggle-group">
                            <div class="toggle-info">
                                <div class="toggle-title">reCAPTCHA</div>
                                <div class="toggle-desc">Kayıt ve giriş formlarında reCAPTCHA kullan</div>
                            </div>
                            <label class="toggle-switch">
                                <input type="checkbox" name="recaptcha" checked>
                                <span class="toggle-slider"></span>
                            </label>
                        </div>
                        
                        <div class="form-row" style="margin-top: 24px;">
                            <div class="form-group">
                                <label class="form-label">Oturum Süresi (dakika)</label>
                                <input type="number" class="form-input" name="session_timeout" value="60">
                            </div>
                            <div class="form-group">
                                <label class="form-label">Max Giriş Denemesi</label>
                                <input type="number" class="form-input" name="max_login_attempts" value="5">
                            </div>
                        </div>
                        
                        <div class="form-group">
                            <label class="form-label">Hesap Kilitleme Süresi (dakika)</label>
                            <input type="number" class="form-input" name="lockout_duration" value="30">
                            <p class="form-help">Başarısız giriş denemelerinden sonra hesap bu süre kadar kilitlenir</p>
                        </div>
                    </div>
                    <div class="card-footer">
                        <button type="submit" class="btn btn-primary">Değişiklikleri Kaydet</button>
                    </div>
                </div>
            </form>
        </div>

        <!-- Bakım Modu -->
        <div class="settings-section" id="bakim" style="display: none;">
            <form action="/admin/ayarlar/bakim" method="POST">
                <div class="settings-card">
                    <div class="card-header">
                        <div>
                            <h2 class="card-title">Bakım Modu</h2>
                            <p class="card-subtitle">Site bakım ve önbellek ayarları</p>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="toggle-group">
                            <div class="toggle-info">
                                <div class="toggle-title">Bakım Modu</div>
                                <div class="toggle-desc">Siteyi bakım moduna al (sadece adminler erişebilir)</div>
                            </div>
                            <label class="toggle-switch">
                                <input type="checkbox" name="maintenance_mode">
                                <span class="toggle-slider"></span>
                            </label>
                        </div>
                        
                        <div class="form-group" style="margin-top: 24px;">
                            <label class="form-label">Bakım Mesajı</label>
                            <textarea class="form-textarea" name="maintenance_message">Sitemiz şu anda bakımda. Kısa süre içinde tekrar hizmetinizde olacağız!</textarea>
                        </div>
                    </div>
                    <div class="card-footer">
                        <button type="button" class="btn btn-secondary" onclick="clearCache()">Önbelleği Temizle</button>
                        <button type="submit" class="btn btn-primary">Değişiklikleri Kaydet</button>
                    </div>
                </div>
            </form>
            
            <!-- Danger Zone -->
            <div class="settings-card danger-zone" style="margin-top: 24px;">
                <div class="card-header">
                    <div>
                        <h2 class="card-title" style="color: #ef4444;">Tehlikeli Bölge</h2>
                        <p class="card-subtitle">Bu işlemler geri alınamaz</p>
                    </div>
                </div>
                <div class="card-body">
                    <div class="danger-item">
                        <div class="danger-info">
                            <h4>Tüm Önbelleği Sil</h4>
                            <p>Tüm önbellek verilerini temizle</p>
                        </div>
                        <button type="button" class="btn btn-danger" onclick="clearAllCache()">Temizle</button>
                    </div>
                    <div class="danger-item">
                        <div class="danger-info">
                            <h4>Tüm Oturumları Sonlandır</h4>
                            <p>Tüm kullanıcıların oturumlarını kapat</p>
                        </div>
                        <button type="button" class="btn btn-danger" onclick="terminateSessions()">Sonlandır</button>
                    </div>
                    <div class="danger-item">
                        <div class="danger-info">
                            <h4>Veritabanı Yedeği Al</h4>
                            <p>Tüm veritabanının yedeğini indir</p>
                        </div>
                        <button type="button" class="btn btn-secondary" onclick="backupDatabase()">Yedek Al</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function showSection(sectionId) {
    // Hide all sections
    document.querySelectorAll('.settings-section').forEach(section => {
        section.style.display = 'none';
    });
    
    // Remove active from all nav items
    document.querySelectorAll('.nav-item').forEach(item => {
        item.classList.remove('active');
    });
    
    // Show selected section
    document.getElementById(sectionId).style.display = 'block';
    
    // Add active to clicked nav item
    event.currentTarget.classList.add('active');
}

function testEmail() {
    if (confirm('Test e-postası göndermek istiyor musunuz?')) {
        fetch('/admin/ayarlar/test-email', { method: 'POST' })
            .then(response => response.json())
            .then(data => {
                alert(data.success ? 'Test e-postası gönderildi!' : 'E-posta gönderilemedi: ' + data.error);
            });
    }
}

function clearCache() {
    if (confirm('Önbelleği temizlemek istiyor musunuz?')) {
        fetch('/admin/ayarlar/clear-cache', { method: 'POST' })
            .then(() => alert('Önbellek temizlendi!'));
    }
}

function clearAllCache() {
    if (confirm('TÜM önbelleği temizlemek istiyor musunuz? Bu işlem geri alınamaz.')) {
        fetch('/admin/ayarlar/clear-all-cache', { method: 'POST' })
            .then(() => alert('Tüm önbellek temizlendi!'));
    }
}

function terminateSessions() {
    if (confirm('TÜM kullanıcı oturumlarını sonlandırmak istiyor musunuz? Herkes yeniden giriş yapmak zorunda kalacak.')) {
        fetch('/admin/ayarlar/terminate-sessions', { method: 'POST' })
            .then(() => alert('Tüm oturumlar sonlandırıldı!'));
    }
}

function backupDatabase() {
    window.location.href = '/admin/ayarlar/backup';
}

// Color preview update
document.querySelectorAll('.color-input').forEach(input => {
    input.addEventListener('input', function() {
        this.parentElement.querySelector('.color-preview').style.background = this.value;
    });
});
</script>
