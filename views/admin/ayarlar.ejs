        <!-- Bildirim Ayarları -->
        <div class="settings-section" id="bildirimler" style="display: none;">
            <form action="/admin/ayarlar/bildirimler" method="POST">
                <div class="settings-card">
                    <div class="card-header">
                        <div>
                            <h2 class="card-title">Bildirim Ayarları</h2>
