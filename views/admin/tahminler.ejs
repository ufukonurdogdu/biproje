<!-- Add/Edit Modal -->
<div class="modal-overlay" id="addModal">
    <div class="modal">
        <div class="modal-header">
            <h3 class="modal-title">Yeni Tahmin Ekle</h3>
            <button class="modal-close" onclick="closeModal('addModal')">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"/>
                    <line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </button>
        </div>
        <form action="/admin/tahminler/ekle" method="POST" enctype="multipart/form-data">
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Tahmin Başlığı *</label>
                    <input type="text" class="form-input" name="title" placeholder="Örn: Galatasaray vs Fenerbahçe Maç Skoru" required>
                </div>
                
                <div class="form-group">
                    <label class="form-label">Açıklama</label>
                    <textarea class="form-textarea" name="description" placeholder="Tahmin hakkında detaylı açıklama..."></textarea>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Kategori *</label>
                        <select class="form-select" name="category" required>
                            <option value="">Seçiniz</option>
                            <option value="spor">Spor</option>
                            <option value="ekonomi">Ekonomi</option>
                            <option value="teknoloji">Teknoloji</option>
                            <option value="eglence">Eğlence</option>
                            <option value="siyaset">Siyaset</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Bitiş Tarihi *</label>
                        <input type="datetime-local" class="form-input" name="end_date" required>
                    </div>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Minimum Bahis (bi!)</label>
                        <input type="number" class="form-input" name="min_bet" value="100" min="10">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Maksimum Bahis (bi!)</label>
                        <input type="number" class="form-input" name="max_bet" value="10000" min="100">
                    </div>
                </div>
                
                <div class="form-group">
                    <label class="form-label">Tahmin Seçenekleri</label>
                    <div id="optionsContainer">
                        <div class="form-row" style="margin-bottom: 8px;">
                            <input type="text" class="form-input" name="options[]" placeholder="Seçenek 1" required>
                            <input type="text" class="form-input" name="options[]" placeholder="Seçenek 2" required>
                        </div>
                    </div>
                    <button type="button" class="btn btn-secondary btn-sm" onclick="addOption()" style="margin-top: 8px;">
                        + Seçenek Ekle
                    </button>
                </div>
                
                <div class="form-group">
                    <label class="form-label">Görsel</label>
                    <div class="image-upload" onclick="document.getElementById('imageInput').click()">
                        <svg class="image-upload-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                            <circle cx="8.5" cy="8.5" r="1.5"/>
                            <polyline points="21 15 16 10 5 21"/>
                        </svg>
                        <p class="image-upload-text">Görsel yüklemek için tıklayın veya sürükleyin</p>
                    </div>
                    <input type="file" id="imageInput" name="image" accept="image/*" hidden>
                </div>
                
                <div class="checkbox-group">
                    <input type="checkbox" id="featured" name="featured">
                    <label for="featured">Öne çıkan tahmin olarak işaretle</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeModal('addModal')">İptal</button>
                <button type="submit" class="btn btn-primary">Tahmin Ekle</button>
            </div>
        </form>
    </div>
</div>

<script>
function openModal(modalId) {
    document.getElementById(modalId).classList.add('active');
}

function closeModal(modalId) {
    document.getElementById(modalId).classList.remove('active');
}

function addOption() {
    const container = document.getElementById('optionsContainer');
    const row = document.createElement('div');
    row.className = 'form-row';
    row.style.marginBottom = '8px';
    row.innerHTML = `
        <input type="text" class="form-input" name="options[]" placeholder="Yeni seçenek">
        <button type="button" class="btn btn-secondary btn-icon" onclick="this.parentElement.remove()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18"/>
                <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
        </button>
    `;
    container.appendChild(row);
}

function viewPrediction(id) {
    window.location.href = '/admin/tahminler/' + id;
}

function editPrediction(id) {
    window.location.href = '/admin/tahminler/' + id + '/duzenle';
}

function deletePrediction(id) {
    if (confirm('Bu tahmini silmek istediğinizden emin misiniz?')) {
        fetch('/admin/tahminler/' + id, {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' }
        }).then(response => {
            if (response.ok) {
                window.location.reload();
            }
        });
    }
}

function exportData() {
    window.location.href = '/admin/tahminler/export';
}

// Filter functionality
document.getElementById('searchInput').addEventListener('input', filterTable);
document.getElementById('categoryFilter').addEventListener('change', filterTable);
document.getElementById('statusFilter').addEventListener('change', filterTable);

function filterTable() {
    // Client-side filtering logic
    const search = document.getElementById('searchInput').value.toLowerCase();
    const category = document.getElementById('categoryFilter').value.toLowerCase();
    const status = document.getElementById('statusFilter').value.toLowerCase();
    
    const rows = document.querySelectorAll('.data-table tbody tr');
    rows.forEach(row => {
        const text = row.textContent.toLowerCase();
        const matchSearch = !search || text.includes(search);
        const matchCategory = !category || text.includes(category);
        const matchStatus = !status || row.querySelector('.status-badge')?.classList.contains('status-' + status);
        
        row.style.display = matchSearch && matchCategory && matchStatus ? '' : 'none';
    });
}

// Close modal on outside click
document.querySelectorAll('.modal-overlay').forEach(modal => {
    modal.addEventListener('click', function(e) {
        if (e.target === this) {
            this.classList.remove('active');
        }
    });
});
</script>
