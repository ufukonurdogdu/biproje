                    <%= cat.icon %>
                </div>
                <div class="category-info">
                    <div class="category-name"><%= cat.name %></div>
                    <div class="category-slug">/<%= cat.slug %></div>
                </div>
                <span class="category-status status-<%= cat.status %>">
                    <%= cat.status === 'active' ? 'Aktif' : 'Pasif' %>
                </span>
            </div>
            <div class="category-stats">
                <div class="stat-item">
                    <div class="stat-value"><%= cat.prediction_count %></div>
                    <div class="stat-label">Tahmin</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value"><%= cat.participant_count %></div>
                    <div class="stat-label">Katılımcı</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value"><%= cat.total_pool %></div>
                    <div class="stat-label">Toplam bi!</div>
                </div>
            </div>
            <div class="category-footer">
                <span class="category-date">Oluşturulma: <%= new Date(cat.created_at).toLocaleDateString('tr-TR') %></span>
