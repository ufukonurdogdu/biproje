<!-- Add Category Modal -->
<div class="modal-overlay" id="addCategoryModal">
    <div class="modal">
        <div class="modal-header">
            <h3 class="modal-title">Yeni Kategori Ekle</h3>
            <button class="modal-close" onclick="closeModal('addCategoryModal')">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"/>
                    <line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </button>
        </div>
        <form action="/admin/kategoriler/ekle" method="POST">
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Kategori Adı *</label>
                    <input type="text" class="form-input" name="name" id="categoryName" placeholder="Örn: Spor" required>
                </div>
                
                <div class="form-group">
                    <label class="form-label">URL Slug</label>
                    <input type="text" class="form-input" name="slug" id="categorySlug" placeholder="Otomatik oluşturulur">
                    <p class="form-help">Boş bırakırsanız otomatik oluşturulur</p>
                </div>
                
                <div class="form-group">
                    <label class="form-label">Açıklama</label>
                    <textarea class="form-textarea" name="description" placeholder="Kategori açıklaması..."></textarea>
                </div>
                
                <div class="form-group">
                    <label class="form-label">İkon Seçin</label>
                    <div class="icon-picker">
                        <div class="icon-option selected" data-icon="⚽" onclick="selectIcon(this)">⚽</div>
                        <div class="icon-option" data-icon="📈" onclick="selectIcon(this)">📈</div>
                        <div class="icon-option" data-icon="💻" onclick="selectIcon(this)">💻</div>
                        <div class="icon-option" data-icon="🎬" onclick="selectIcon(this)">🎬</div>
                        <div class="icon-option" data-icon="🏛️" onclick="selectIcon(this)">🏛️</div>
                        <div class="icon-option" data-icon="🌍" onclick="selectIcon(this)">🌍</div>
                        <div class="icon-option" data-icon="🎮" onclick="selectIcon(this)">🎮</div>
                        <div class="icon-option" data-icon="🎵" onclick="selectIcon(this)">🎵</div>
                        <div class="icon-option" data-icon="📚" onclick="selectIcon(this)">📚</div>
                        <div class="icon-option" data-icon="🏆" onclick="selectIcon(this)">🏆</div>
                        <div class="icon-option" data-icon="💰" onclick="selectIcon(this)">💰</div>
                        <div class="icon-option" data-icon="🚀" onclick="selectIcon(this)">🚀</div>
                    </div>
                    <input type="hidden" name="icon" id="selectedIcon" value="⚽">
                </div>
                
                <div class="form-group">
                    <label class="form-label">Renk Seçin</label>
                    <div class="color-picker">
                        <div class="color-option selected" style="background: #22c55e;" data-color="#22c55e" onclick="selectColor(this)"></div>
                        <div class="color-option" style="background: #f59e0b;" data-color="#f59e0b" onclick="selectColor(this)"></div>
                        <div class="color-option" style="background: #6366f1;" data-color="#6366f1" onclick="selectColor(this)"></div>
                        <div class="color-option" style="background: #ec4899;" data-color="#ec4899" onclick="selectColor(this)"></div>
                        <div class="color-option" style="background: #ef4444;" data-color="#ef4444" onclick="selectColor(this)"></div>
                        <div class="color-option" style="background: #8b5cf6;" data-color="#8b5cf6" onclick="selectColor(this)"></div>
                        <div class="color-option" style="background: #14b8a6;" data-color="#14b8a6" onclick="selectColor(this)"></div>
                        <div class="color-option" style="background: #f97316;" data-color="#f97316" onclick="selectColor(this)"></div>
                    </div>
                    <input type="hidden" name="color" id="selectedColor" value="#22c55e">
                </div>
                
                <div class="checkbox-group">
                    <input type="checkbox" id="isActive" name="is_active" checked>
                    <label for="isActive">Aktif olarak yayınla</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeModal('addCategoryModal')">İptal</button>
                <button type="submit" class="btn btn-primary">Kategori Ekle</button>
            </div>
        </form>
    </div>
</div>

<script>
function openModal(modalId) {
    document.getElementById(modalId).classList.add('active');
}

function closeModal(modalId) {
    document.getElementById(modalId).classList.remove('active');
}

function selectIcon(element) {
    document.querySelectorAll('.icon-option').forEach(el => el.classList.remove('selected'));
    element.classList.add('selected');
    document.getElementById('selectedIcon').value = element.dataset.icon;
}

function selectColor(element) {
    document.querySelectorAll('.color-option').forEach(el => el.classList.remove('selected'));
    element.classList.add('selected');
    document.getElementById('selectedColor').value = element.dataset.color;
}

// Auto-generate slug
document.getElementById('categoryName').addEventListener('input', function() {
    const slug = this.value
        .toLowerCase()
        .replace(/ğ/g, 'g')
        .replace(/ü/g, 'u')
        .replace(/ş/g, 's')
        .replace(/ı/g, 'i')
        .replace(/ö/g, 'o')
        .replace(/ç/g, 'c')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/-+/g, '-')
        .replace(/^-|-$/g, '');
    document.getElementById('categorySlug').placeholder = slug || 'Otomatik oluşturulur';
});

function editCategory(id) {
    window.location.href = '/admin/kategoriler/' + id + '/duzenle';
}

function deleteCategory(id) {
    if (confirm('Bu kategoriyi silmek istediğinizden emin misiniz? Bu işlem geri alınamaz.')) {
        fetch('/admin/kategoriler/' + id, {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' }
        }).then(response => {
            if (response.ok) {
                window.location.reload();
            }
        });
    }
}

// Close modal on outside click
document.querySelectorAll('.modal-overlay').forEach(modal => {
    modal.addEventListener('click', function(e) {
        if (e.target === this) {
            this.classList.remove('active');
        }
    });
});
</script>
