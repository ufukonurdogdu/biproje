<nav class="navbar">
    <div class="navbar-content">
        <a href="/" class="logo">
            <div class="logo-icon">B</div>
            <span class="logo-text">Bilemezsin</span>
        </a>

        <div class="nav-center">
            <a href="/" class="nav-link">Ana Sayfa</a>
            <a href="/siralama" class="nav-link">Sıralama</a>
            <a href="/dashboard" class="nav-link active">Profilim</a>
        </div>

        <div class="nav-right">
            <div class="bi-badge">
                <div class="bi-icon">bi!</div>
                <span><%= user ? user.bi_coin.toLocaleString('tr-TR') : '0' %></span>
            </div>

            <div class="theme-toggle">
                <button class="theme-btn active" id="lightBtn">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="5"/>
                        <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
                    </svg>
                </button>
                <button class="theme-btn" id="darkBtn">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                    </svg>
                </button>
            </div>

            <button class="notification-btn" onclick="window.location.href='/dashboard/bildirimler'">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                <span class="notification-dot"></span>
            </button>

            <div class="user-dropdown">
                <div class="user-avatar">
                    <% if (user && user.avatar) { %>
                        <img src="<%= user.avatar %>" alt="<%= user.ad_soyad %>">
                    <% } else if (user) { %>
                        <%= user.ad_soyad.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() %>
                    <% } %>
                </div>
                <div class="dropdown-menu">
                    <a href="/dashboard" class="dropdown-item">Dashboard</a>
                    <a href="/dashboard/profil" class="dropdown-item">Profil</a>
                    <a href="/dashboard/ayarlar" class="dropdown-item">Ayarlar</a>
                    <% if (user && ['admin', 'superadmin'].includes(user.rol)) { %>
                        <a href="/admin" class="dropdown-item">Admin Panel</a>
                    <% } %>
                    <div class="dropdown-divider"></div>
                    <a href="/auth/cikis" class="dropdown-item">Çıkış Yap</a>
                </div>
            </div>
        </div>
    </div>
</nav>
