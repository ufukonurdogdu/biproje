<nav class="navbar">
    <div class="navbar-content">
        <a href="/" class="logo">
            <div class="logo-icon">B</div>
            <span class="logo-text">Bilemezsin</span>
        </a>

        <div class="nav-center">
            <a href="/" class="nav-link">Ana Sayfa</a>
            <a href="/siralama" class="nav-link">Sıralama</a>
            <a href="/hakkimizda" class="nav-link">Hakkımızda</a>
        </div>

        <div class="nav-right">
            <% if (user) { %>
                <a href="/dashboard" class="bi-badge">
                    <div class="bi-icon">bi!</div>
                    <span><%= user.bi_coin ? user.bi_coin.toLocaleString('tr-TR') : '0' %></span>
                </a>
                <a href="/dashboard" class="user-avatar" title="<%= user.ad_soyad || 'Kullanıcı' %>">
                    <% if (user.avatar) { %>
                        <img src="<%= user.avatar %>" alt="<%= user.ad_soyad || 'Kullanıcı' %>">
                    <% } else if (user.ad_soyad) { %>
                        <%= user.ad_soyad.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() %>
                    <% } else { %>
                        U
                    <% } %>
                </a>
            <% } else { %>
                <a href="/auth/giris" class="btn btn-secondary">Giriş Yap</a>
                <a href="/auth/kayit" class="btn btn-primary">Kayıt Ol</a>
            <% } %>
            <div class="theme-toggle">
                <button class="theme-btn active" id="lightBtn" title="Açık Tema">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="5"/>
                        <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
                    </svg>
                </button>
                <button class="theme-btn" id="darkBtn" title="Koyu Tema">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                    </svg>
                </button>
            </div>
        </div>
    </div>
</nav>
