<%- contentFor('body') %>

<style>
    /* Page Header */
    .page-header {
        margin-bottom: 1.5rem;
    }

    .page-title {
        font-size: 1.5rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .page-title svg {
        width: 28px;
        height: 28px;
        color: var(--accent-primary);
    }

    .page-subtitle {
        color: var(--text-muted);
        font-size: 0.95rem;
    }

    /* Leaderboard Layout */
    .leaderboard-layout {
        display: grid;
        grid-template-columns: 1fr 320px;
        gap: 1.5rem;
    }

    /* Card */
    .card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        overflow: hidden;
    }

    .card-header {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .card-title {
        font-size: 1rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .card-title svg {
        width: 20px;
        height: 20px;
        color: var(--accent-primary);
    }

    .card-body {
        padding: 1.25rem;
    }

    /* Period Tabs */
    .period-tabs {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 0.5rem;
    }

    .period-tab {
        flex: 1;
        padding: 0.75rem 1rem;
        background: transparent;
        border: none;
        border-radius: 8px;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--text-secondary);
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .period-tab:hover {
        color: var(--text-primary);
        background: var(--bg-input);
    }

    .period-tab.active {
        background: var(--accent-primary);
        color: white;
    }

    /* Top 3 Podium */
    .podium-section {
        display: flex;
        justify-content: center;
        align-items: flex-end;
        gap: 1rem;
        margin-bottom: 2rem;
        padding: 2rem 1rem;
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.1), rgba(139, 92, 246, 0.1));
        border-radius: 16px;
    }

    .podium-item {
        text-align: center;
        transition: transform 0.3s ease;
    }

    .podium-item:hover {
        transform: translateY(-5px);
    }

    .podium-item.first {
        order: 2;
    }

    .podium-item.second {
        order: 1;
    }

    .podium-item.third {
        order: 3;
    }

    .podium-avatar {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        font-weight: 800;
        color: white;
        margin: 0 auto 0.75rem;
        position: relative;
        border: 4px solid var(--bg-card);
        box-shadow: var(--shadow-lg);
    }

    .podium-item.first .podium-avatar {
        width: 100px;
        height: 100px;
        font-size: 2rem;
        border-color: #fbbf24;
    }

    .podium-item.second .podium-avatar {
        border-color: #9ca3af;
    }

    .podium-item.third .podium-avatar {
        border-color: #d97706;
    }

    .podium-crown {
        position: absolute;
        top: -20px;
        left: 50%;
        transform: translateX(-50%);
        font-size: 1.5rem;
    }

    .podium-item.first .podium-crown {
        font-size: 2rem;
        top: -25px;
    }

    .podium-rank {
        position: absolute;
        bottom: -5px;
        right: -5px;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        font-weight: 800;
        color: white;
    }

    .podium-item.first .podium-rank {
        background: linear-gradient(135deg, #fbbf24, #f59e0b);
        width: 32px;
        height: 32px;
        font-size: 0.9rem;
    }

    .podium-item.second .podium-rank {
        background: linear-gradient(135deg, #9ca3af, #6b7280);
    }

    .podium-item.third .podium-rank {
        background: linear-gradient(135deg, #d97706, #b45309);
    }

    .podium-name {
        font-size: 1rem;
        font-weight: 700;
        margin-bottom: 0.25rem;
    }

    .podium-item.first .podium-name {
        font-size: 1.1rem;
    }

    .podium-stats {
        font-size: 0.8rem;
        color: var(--text-muted);
        margin-bottom: 0.5rem;
    }

    .podium-points {
        font-size: 1.1rem;
        font-weight: 800;
        color: var(--bi-color);
    }

    .podium-item.first .podium-points {
        font-size: 1.3rem;
    }

    .podium-stand {
        width: 100%;
        height: 60px;
        border-radius: 8px 8px 0 0;
        margin-top: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        font-weight: 800;
        color: rgba(255,255,255,0.5);
    }

    .podium-item.first .podium-stand {
        background: linear-gradient(135deg, #fbbf24, #f59e0b);
        height: 80px;
    }

    .podium-item.second .podium-stand {
        background: linear-gradient(135deg, #9ca3af, #6b7280);
    }

    .podium-item.third .podium-stand {
        background: linear-gradient(135deg, #d97706, #b45309);
    }

    /* Leaderboard List */
    .leaderboard-list {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        overflow: hidden;
    }

    .leaderboard-header {
        display: grid;
        grid-template-columns: 60px 1fr 100px 100px 100px;
        gap: 1rem;
        padding: 0.875rem 1.25rem;
        background: var(--bg-input);
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--text-muted);
    }

    .leaderboard-item {
        display: grid;
        grid-template-columns: 60px 1fr 100px 100px 100px;
        gap: 1rem;
        padding: 1rem 1.25rem;
        align-items: center;
        border-bottom: 1px solid var(--border-color);
        transition: all 0.2s ease;
    }

    .leaderboard-item:last-child {
        border-bottom: none;
    }

    .leaderboard-item:hover {
        background: var(--bg-card-hover);
    }

    .leaderboard-item.current-user {
        background: rgba(99, 102, 241, 0.1);
        border-left: 4px solid var(--accent-primary);
    }

    .lb-rank {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
        font-weight: 800;
        background: var(--bg-input);
        color: var(--text-secondary);
    }

    .lb-rank.gold { 
        background: linear-gradient(135deg, #fbbf24, #f59e0b); 
        color: #000; 
    }
    .lb-rank.silver { 
        background: linear-gradient(135deg, #9ca3af, #6b7280); 
        color: #000; 
    }
    .lb-rank.bronze { 
        background: linear-gradient(135deg, #d97706, #b45309); 
        color: #fff; 
    }

    .lb-user {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .lb-avatar {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
        font-weight: 700;
        color: white;
    }

    .lb-user-info {
        flex: 1;
    }

    .lb-name {
        font-size: 0.95rem;
        font-weight: 600;
        margin-bottom: 0.15rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .lb-name .badge {
        padding: 0.15rem 0.4rem;
        font-size: 0.6rem;
        border-radius: 4px;
        font-weight: 700;
    }

    .lb-name .badge.premium {
        background: linear-gradient(135deg, var(--bi-color), #d97706);
        color: white;
    }

    .lb-username {
        font-size: 0.8rem;
        color: var(--text-muted);
    }

    .lb-accuracy {
        text-align: center;
    }

    .lb-accuracy-value {
        font-size: 1rem;
        font-weight: 700;
        color: var(--accent-success);
    }

    .lb-accuracy-label {
        font-size: 0.7rem;
        color: var(--text-muted);
    }

    .lb-predictions {
        text-align: center;
    }

    .lb-predictions-value {
        font-size: 1rem;
        font-weight: 700;
    }

    .lb-predictions-label {
        font-size: 0.7rem;
        color: var(--text-muted);
    }

    .lb-points {
        text-align: right;
    }

    .lb-points-value {
        font-size: 1.1rem;
        font-weight: 800;
        color: var(--bi-color);
    }

    .lb-points-label {
        font-size: 0.7rem;
        color: var(--text-muted);
    }

    /* Sidebar */
    .sidebar {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    /* My Rank Card */
    .my-rank-card {
        background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
        border: none;
        color: white;
    }

    .my-rank-card .card-header {
        border-bottom-color: rgba(255,255,255,0.2);
    }

    .my-rank-card .card-title {
        color: white;
    }

    .my-rank-card .card-title svg {
        color: white;
    }

    .my-rank-content {
        text-align: center;
        padding: 1.5rem;
    }

    .my-rank-avatar {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: rgba(255,255,255,0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        font-weight: 800;
        margin: 0 auto 1rem;
        border: 3px solid rgba(255,255,255,0.3);
    }

    .my-rank-position {
        font-size: 3rem;
        font-weight: 800;
        margin-bottom: 0.25rem;
    }

    .my-rank-label {
        opacity: 0.9;
        font-size: 0.9rem;
        margin-bottom: 1rem;
    }

    .my-rank-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        padding-top: 1rem;
        border-top: 1px solid rgba(255,255,255,0.2);
    }

    .my-rank-stat {
        text-align: center;
    }

    .my-rank-stat-value {
        font-size: 1.25rem;
        font-weight: 800;
    }

    .my-rank-stat-label {
        font-size: 0.7rem;
        opacity: 0.8;
    }

    /* Category Leaderboard */
    .category-lb-tabs {
        display: flex;
        gap: 0.25rem;
        padding: 0.5rem;
        overflow-x: auto;
        border-bottom: 1px solid var(--border-color);
    }

    .category-lb-tab {
        padding: 0.4rem 0.75rem;
        background: transparent;
        border: none;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--text-muted);
        cursor: pointer;
        white-space: nowrap;
    }

    .category-lb-tab.active {
        background: var(--accent-primary);
        color: white;
    }

    .category-lb-list {
        padding: 0.75rem;
    }

    .category-lb-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.5rem;
        border-radius: 8px;
        margin-bottom: 0.5rem;
    }

    .category-lb-item:hover {
        background: var(--bg-input);
    }

    .category-lb-rank {
        width: 24px;
        height: 24px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.7rem;
        font-weight: 800;
        background: var(--bg-input);
        color: var(--text-muted);
    }

    .category-lb-rank.gold { background: linear-gradient(135deg, #fbbf24, #f59e0b); color: #000; }
    .category-lb-rank.silver { background: linear-gradient(135deg, #9ca3af, #6b7280); color: #000; }
    .category-lb-rank.bronze { background: linear-gradient(135deg, #d97706, #b45309); color: #fff; }

    .category-lb-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.7rem;
        font-weight: 700;
        color: white;
    }

    .category-lb-info {
        flex: 1;
    }

    .category-lb-name {
        font-size: 0.85rem;
        font-weight: 600;
    }

    .category-lb-accuracy {
        font-size: 0.7rem;
        color: var(--accent-success);
    }

    .category-lb-points {
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--bi-color);
    }

    /* Pagination */
    .pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.5rem;
        margin-top: 1.5rem;
    }

    .page-btn {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--text-secondary);
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .page-btn:hover {
        border-color: var(--accent-primary);
        color: var(--accent-primary);
    }

    .page-btn.active {
        background: var(--accent-primary);
        border-color: var(--accent-primary);
        color: white;
    }

    .page-btn svg {
        width: 18px;
        height: 18px;
    }

    /* Responsive */
    @media (max-width: 1024px) {
        .leaderboard-layout {
            grid-template-columns: 1fr;
        }

        .sidebar {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 768px) {
        .podium-section {
            flex-direction: column;
            align-items: center;
        }

        .podium-item.first,
        .podium-item.second,
        .podium-item.third {
            order: unset;
        }

        .podium-stand {
            display: none;
        }

        .leaderboard-header,
        .leaderboard-item {
            grid-template-columns: 50px 1fr 80px;
        }

        .lb-accuracy,
        .lb-predictions {
            display: none;
        }

        .sidebar {
            grid-template-columns: 1fr;
        }

        .period-tabs {
            flex-wrap: wrap;
        }
    }
</style>

<!-- Page Header -->
<div class="page-header">
    <h1 class="page-title">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/>
            <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/>
            <path d="M4 22h16"/>
            <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/>
            <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/>
            <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>
        </svg>
        Sıralama
    </h1>
    <p class="page-subtitle">En iyi tahminciler arasında yerini al!</p>
</div>

<!-- Period Tabs -->
<div class="period-tabs">
    <button class="period-tab active" data-period="weekly">Haftalık</button>
    <button class="period-tab" data-period="monthly">Aylık</button>
    <button class="period-tab" data-period="all">Tüm Zamanlar</button>
</div>

<!-- Leaderboard Layout -->
<div class="leaderboard-layout">
    <!-- Main Content -->
    <div>
        <!-- Top 3 Podium -->
        <div class="podium-section">
            <div class="podium-item second">
                <div class="podium-avatar">
                    <span class="podium-crown">🥈</span>
                    AY
                    <span class="podium-rank">2</span>
                </div>
                <div class="podium-name">Ayşe Yılmaz</div>
                <div class="podium-stats">%89 doğruluk • 234 tahmin</div>
                <div class="podium-points">42,180 bi!</div>
                <div class="podium-stand">2</div>
            </div>

            <div class="podium-item first">
                <div class="podium-avatar">
                    <span class="podium-crown">👑</span>
                    MK
                    <span class="podium-rank">1</span>
                </div>
                <div class="podium-name">Mehmet Kaya</div>
                <div class="podium-stats">%92 doğruluk • 312 tahmin</div>
                <div class="podium-points">45,230 bi!</div>
                <div class="podium-stand">1</div>
            </div>

            <div class="podium-item third">
                <div class="podium-avatar">
                    <span class="podium-crown">🥉</span>
                    CD
                    <span class="podium-rank">3</span>
                </div>
                <div class="podium-name">Can Demir</div>
                <div class="podium-stats">%87 doğruluk • 198 tahmin</div>
                <div class="podium-points">38,920 bi!</div>
                <div class="podium-stand">3</div>
            </div>
        </div>

        <!-- Leaderboard List -->
        <div class="leaderboard-list">
            <div class="leaderboard-header">
                <div>Sıra</div>
                <div>Kullanıcı</div>
                <div>Doğruluk</div>
                <div>Tahmin</div>
                <div style="text-align: right;">Puan</div>
            </div>

            <% if (typeof leaderboard !== 'undefined' && leaderboard.length > 0) { %>
                <% leaderboard.forEach(function(user, index) { %>
                    <div class="leaderboard-item <%= user.isCurrentUser ? 'current-user' : '' %>">
                        <div class="lb-rank <%= index === 0 ? 'gold' : index === 1 ? 'silver' : index === 2 ? 'bronze' : '' %>">
                            <%= index + 1 %>
                        </div>
                        <div class="lb-user">
                            <div class="lb-avatar"><%= user.initials %></div>
                            <div class="lb-user-info">
                                <div class="lb-name">
                                    <%= user.name %>
                                    <% if (user.isPremium) { %>
                                        <span class="badge premium">👑</span>
                                    <% } %>
                                </div>
                                <div class="lb-username">@<%= user.username %></div>
                            </div>
                        </div>
                        <div class="lb-accuracy">
                            <div class="lb-accuracy-value">%<%= user.accuracy %></div>
                            <div class="lb-accuracy-label">doğruluk</div>
                        </div>
                        <div class="lb-predictions">
                            <div class="lb-predictions-value"><%= user.predictions %></div>
                            <div class="lb-predictions-label">tahmin</div>
                        </div>
                        <div class="lb-points">
                            <div class="lb-points-value"><%= user.points.toLocaleString('tr-TR') %></div>
                            <div class="lb-points-label">bi!</div>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <!-- Sample data -->
                <div class="leaderboard-item">
                    <div class="lb-rank gold">1</div>
                    <div class="lb-user">
                        <div class="lb-avatar">MK</div>
                        <div class="lb-user-info">
                            <div class="lb-name">Mehmet Kaya <span class="badge premium">👑</span></div>
                            <div class="lb-username">@mehmetkaya</div>
                        </div>
                    </div>
                    <div class="lb-accuracy">
                        <div class="lb-accuracy-value">%92</div>
                        <div class="lb-accuracy-label">doğruluk</div>
                    </div>
                    <div class="lb-predictions">
                        <div class="lb-predictions-value">312</div>
                        <div class="lb-predictions-label">tahmin</div>
                    </div>
                    <div class="lb-points">
                        <div class="lb-points-value">45,230</div>
                        <div class="lb-points-label">bi!</div>
                    </div>
                </div>

                <div class="leaderboard-item">
                    <div class="lb-rank silver">2</div>
                    <div class="lb-user">
                        <div class="lb-avatar">AY</div>
                        <div class="lb-user-info">
                            <div class="lb-name">Ayşe Yılmaz</div>
                            <div class="lb-username">@ayseyilmaz</div>
                        </div>
                    </div>
                    <div class="lb-accuracy">
                        <div class="lb-accuracy-value">%89</div>
                        <div class="lb-accuracy-label">doğruluk</div>
                    </div>
                    <div class="lb-predictions">
                        <div class="lb-predictions-value">234</div>
                        <div class="lb-predictions-label">tahmin</div>
                    </div>
                    <div class="lb-points">
                        <div class="lb-points-value">42,180</div>
                        <div class="lb-points-label">bi!</div>
                    </div>
                </div>

                <div class="leaderboard-item">
                    <div class="lb-rank bronze">3</div>
                    <div class="lb-user">
                        <div class="lb-avatar">CD</div>
                        <div class="lb-user-info">
                            <div class="lb-name">Can Demir <span class="badge premium">👑</span></div>
                            <div class="lb-username">@candemir</div>
                        </div>
                    </div>
                    <div class="lb-accuracy">
                        <div class="lb-accuracy-value">%87</div>
                        <div class="lb-accuracy-label">doğruluk</div>
                    </div>
                    <div class="lb-predictions">
                        <div class="lb-predictions-value">198</div>
                        <div class="lb-predictions-label">tahmin</div>
                    </div>
                    <div class="lb-points">
                        <div class="lb-points-value">38,920</div>
                        <div class="lb-points-label">bi!</div>
                    </div>
                </div>

                <div class="leaderboard-item">
                    <div class="lb-rank">4</div>
                    <div class="lb-user">
                        <div class="lb-avatar">EK</div>
                        <div class="lb-user-info">
                            <div class="lb-name">Elif Koç</div>
                            <div class="lb-username">@elifkoc</div>
                        </div>
