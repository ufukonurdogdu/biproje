<div class="dashboard-container">
    <div class="page-header">
        <h1>Bildirimler</h1>
        <p>Tüm bildirimlerini buradan takip edebilirsin</p>
    </div>

    <div class="card">
        <div class="card-body">
            <% if (bildirimler && bildirimler.length > 0) { %>
                <div class="notifications-list">
                    <% bildirimler.forEach(function(bildirim) { %>
                        <div class="notification-item-large <%= bildirim.okundu_mu ? '' : 'unread' %>">
                            <div class="notification-icon <%= bildirim.tip %>">
                                <% if (bildirim.tip === 'odul') { %>
                                    🎉
                                <% } else if (bildirim.tip === 'tahmin') { %>
                                    🎯
                                <% } else if (bildirim.tip === 'sosyal') { %>
                                    👥
                                <% } else { %>
                                    📢
                                <% } %>
                            </div>
                            <div class="notification-content">
                                <h4 class="notification-title"><%= bildirim.baslik %></h4>
                                <% if (bildirim.mesaj) { %>
                                    <p class="notification-message"><%= bildirim.mesaj %></p>
                                <% } %>
                                <div class="notification-time">
                                    <%= new Date(bildirim.olusturma_tarihi).toLocaleString('tr-TR') %>
                                </div>
                            </div>
                            <% if (bildirim.link) { %>
                                <a href="<%= bildirim.link %>" class="notification-action">
                                    Görüntüle →
                                </a>
                            <% } %>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <div class="empty-icon">🔔</div>
                    <h3>Bildirim yok</h3>
                    <p>Yeni bildirimler burada görünecek</p>
                </div>
            <% } %>
        </div>
    </div>
</div>
