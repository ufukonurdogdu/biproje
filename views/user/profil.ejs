    <%- include('../partials/footer') %>

    <script>
        // Section göster
        function showSection(sectionId) {
            // Nav items
            document.querySelectorAll('.nav-item').forEach(item => item.classList.remove('active'));
            event.target.closest('.nav-item').classList.add('active');
            
            // Sections
            document.querySelectorAll('.section-card').forEach(section => section.classList.remove('active'));
            document.getElementById('section-' + sectionId).classList.add('active');
        }

        // Avatar değiştir
        document.getElementById('avatarInput').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('avatarPreview').innerHTML = '<img src="' + e.target.result + '" alt="Avatar">';
                };
                reader.readAsDataURL(file);
            }
        });

        function removeAvatar() {
            document.getElementById('avatarPreview').innerHTML = 'AY';
        }

        // Şifre gücü kontrolü
        function checkPasswordStrength() {
            const password = document.getElementById('newPassword').value;
            const bars = [
                document.getElementById('str1'),
                document.getElementById('str2'),
                document.getElementById('str3'),
                document.getElementById('str4')
            ];
            const text = document.getElementById('passwordText');
            
            let strength = 0;
            if (password.length >= 8) strength++;
            if (password.match(/[a-z]/) && password.match(/[A-Z]/)) strength++;
            if (password.match(/[0-9]/)) strength++;
            if (password.match(/[^a-zA-Z0-9]/)) strength++;
            
            bars.forEach((bar, index) => {
                bar.className = 'strength-bar';
                if (index < strength) {
                    if (strength <= 1) bar.classList.add('active');
                    else if (strength <= 2) bar.classList.add('medium');
                    else bar.classList.add('strong');
                }
            });
            
            const messages = ['', 'Zayıf', 'Orta', 'İyi', 'Güçlü'];
            text.textContent = messages[strength] || 'En az 8 karakter, büyük/küçük harf ve rakam içermeli';
        }

        // Form submit - artık gerçek form olarak çalışıyor
        // document.getElementById('profileForm').addEventListener('submit', function(e) {
        //     e.preventDefault();
        //     alert('Profil bilgileri kaydedildi!');
        // });

        document.getElementById('securityForm').addEventListener('submit', function(e) {
            e.preventDefault();
            alert('Şifre güncellendi!');
        });

        // Hesap silme onayı
        function confirmDeleteAccount() {
            if (confirm('Hesabınızı silmek istediğinizden emin misiniz? Bu işlem geri alınamaz!')) {
                if (confirm('Son kez onaylayın: Tüm verileriniz silinecek!')) {
                    alert('Hesap silme işlemi başlatıldı. E-postanızı kontrol edin.');
                }
            }
        }

        // Tüm oturumları sonlandır
        function logoutAllSessions() {
            if (confirm('Bu cihaz dahil tüm oturumlar sonlandırılacak. Devam etmek istiyor musunuz?')) {
                alert('Tüm oturumlar sonlandırıldı. Yeniden giriş yapmanız gerekecek.');
            }
        }

        // Theme Management
        const html = document.documentElement;
        const lightBtn = document.getElementById('lightBtn');
        const darkBtn = document.getElementById('darkBtn');

        let themeMode = localStorage.getItem('themeMode') || 'dark';

        function applyTheme() {
            html.setAttribute('data-theme', themeMode);
            updateButtonStates();
        }

        function updateButtonStates() {
            if (lightBtn) lightBtn.classList.remove('active');
            if (darkBtn) darkBtn.classList.remove('active');

            if (themeMode === 'light' && lightBtn) {
                lightBtn.classList.add('active');
            } else if (darkBtn) {
                darkBtn.classList.add('active');
            }
        }

        function setThemeMode(mode) {
            themeMode = mode;
            localStorage.setItem('themeMode', mode);
            applyTheme();
        }

        if (lightBtn) lightBtn.addEventListener('click', () => setThemeMode('light'));
        if (darkBtn) darkBtn.addEventListener('click', () => setThemeMode('dark'));

        applyTheme();

        // Kullanıcı Adı Değiştirme Modal
        function openUsernameModal() {
            document.getElementById('usernameModal').style.display = 'flex';
            document.getElementById('newUsernameInput').focus();
        }

        function closeUsernameModal() {
            document.getElementById('usernameModal').style.display = 'none';
            document.getElementById('newUsernameInput').value = '';
            document.getElementById('usernameAvailability').textContent = '';
            document.getElementById('usernameAvailability').className = 'availability-msg';
            document.getElementById('changeUsernameBtn').disabled = true;
        }

        // Live kullanıcı adı kontrolü
        let usernameCheckTimeout;
        let isUsernameAvailable = false;

        document.getElementById('newUsernameInput').addEventListener('input', function(e) {
            let value = e.target.value.toLowerCase().replace(/[^a-z0-9_]/g, '');
            e.target.value = value;

            clearTimeout(usernameCheckTimeout);
            const availabilityEl = document.getElementById('usernameAvailability');
            const submitBtn = document.getElementById('changeUsernameBtn');
            
            isUsernameAvailable = false;
            submitBtn.disabled = true;

            if (value.length === 0) {
                availabilityEl.textContent = '';
                availabilityEl.className = 'availability-msg';
                return;
            }

            if (value.length < 3) {
                availabilityEl.textContent = '✕ En az 3 karakter olmalı';
                availabilityEl.className = 'availability-msg error';
                return;
            }

            if (value.length > 20) {
                availabilityEl.textContent = '✕ En fazla 20 karakter olabilir';
                availabilityEl.className = 'availability-msg error';
                return;
            }

            availabilityEl.textContent = '⟳ Kontrol ediliyor...';
            availabilityEl.className = 'availability-msg checking';

            usernameCheckTimeout = setTimeout(() => {
                fetch('/api/kullanici-adi-kontrol?kullanici_adi=' + encodeURIComponent(value))
                    .then(res => res.json())
                    .then(data => {
                        if (data.available) {
                            availabilityEl.textContent = '✓ Kullanıcı adı müsait';
                            availabilityEl.className = 'availability-msg success';
                            isUsernameAvailable = true;
                            submitBtn.disabled = false;
                        } else {
                            availabilityEl.textContent = '✕ ' + (data.message || 'Bu kullanıcı adı kullanılamaz');
                            availabilityEl.className = 'availability-msg error';
                            isUsernameAvailable = false;
                            submitBtn.disabled = true;
                        }
                    })
                    .catch(err => {
                        availabilityEl.textContent = '! Kontrol edilemedi';
                        availabilityEl.className = 'availability-msg error';
                    });
            }, 500);
        });

        document.getElementById('usernameChangeForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            if (!isUsernameAvailable) {
                return false;
            }

            const confirmed = confirm('Kullanıcı adınızı değiştirmek için 180 bi! coin harcanacak. Onaylıyor musunuz?');
            if (!confirmed) {
                return false;
            }

            const yeniKullaniciAdi = document.getElementById('newUsernameInput').value;
            const submitBtn = document.getElementById('changeUsernameBtn');

            submitBtn.disabled = true;
            submitBtn.innerHTML = '⟳ İşleniyor...';

            try {
                const response = await fetch('/profil/kullanici-adi-degistir', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ yeni_kullanici_adi: yeniKullaniciAdi })
                });

                const data = await response.json();

                if (data.success) {
                    alert(data.message);
                    window.location.reload();
                } else {
                    alert(data.message || 'Bir hata oluştu');
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<span>🪙</span> 180 bi! ile Değiştir';
                }
            } catch (err) {
                alert('Bir hata oluştu, lütfen tekrar deneyin');
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<span>🪙</span> 180 bi! ile Değiştir';
            }
        });

        // Profil formu submit
        document.getElementById('profileForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const submitBtn = this.querySelector('button[type="submit"]');
            const originalText = submitBtn.innerHTML;
            submitBtn.innerHTML = 'Kaydediliyor...';
            submitBtn.disabled = true;

            const formData = new FormData(this);
            const data = {
                ad_soyad: formData.get('ad_soyad'),
                bio: formData.get('bio')
            };

            console.log('📤 Gönderilen veri:', data);

            try {
                const response = await fetch('/profil/guncelle', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                });

                console.log('📥 Response status:', response.status);
                const result = await response.json();
                console.log('📥 Response data:', result);

                if (result.success) {
                    // Başarı mesajı göster
                    submitBtn.innerHTML = '✓ Kaydedildi!';
                    submitBtn.style.background = 'var(--success)';
                    setTimeout(() => {
                        submitBtn.innerHTML = originalText;
                        submitBtn.style.background = '';
                        submitBtn.disabled = false;
                    }, 2000);
                } else {
                    alert(result.message || 'Bir hata oluştu');
                    submitBtn.innerHTML = originalText;
                    submitBtn.disabled = false;
                }
            } catch (err) {
                console.error('❌ Fetch hatası:', err);
                alert('Bir hata oluştu, lütfen tekrar deneyin');
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
            }
        });
    </script>

    <!-- Kullanıcı Adı Değiştirme Modal -->
    <div id="usernameModal" class="modal-overlay" style="display: none;">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Kullanıcı Adını Değiştir</h3>
                <button type="button" class="modal-close" onclick="closeUsernameModal()">✕</button>
            </div>
            <div class="modal-body">
                <div class="modal-cost-info">
                    <span class="cost-icon">🪙</span>
                    <div class="cost-text">
                        <strong>180 bi!</strong> coin harcanacak
                    </div>
                    <div class="current-balance">
                        Mevcut bakiye: <strong><%= typeof user !== 'undefined' && user ? user.bi_coin : 0 %> bi!</strong>
                    </div>
                </div>
                
                <form id="usernameChangeForm">
                    <div class="form-group">
                        <label class="form-label">Yeni Kullanıcı Adı</label>
                        <div class="input-with-icon">
                            <span class="input-icon">@</span>
                            <input 
                                type="text" 
                                id="newUsernameInput" 
                                name="yeni_kullanici_adi"
                                class="form-input" 
                                placeholder="yeni_kullanici_adi"
                                autocomplete="off"
                                autocapitalize="off"
                                spellcheck="false"
                                maxlength="20"
                                required
                            >
                        </div>
                        <div id="usernameAvailability" class="availability-msg"></div>
                        <span class="form-hint">Sadece harf, rakam ve alt çizgi (_) kullanabilirsiniz</span>
                    </div>
                    
                    <div class="modal-actions">
                        <button type="button" class="btn btn-secondary" onclick="closeUsernameModal()">İptal</button>
                        <button type="submit" id="changeUsernameBtn" class="btn btn-primary" disabled>
                            <span>🪙</span> 180 bi! ile Değiştir
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <style>
