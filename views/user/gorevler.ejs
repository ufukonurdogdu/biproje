    <script>
        // Geri sayım timer
        function updateTimer() {
            const now = new Date();
            const midnight = new Date();
            midnight.setHours(24, 0, 0, 0);
            
            const diff = midnight - now;
            
            const hours = Math.floor(diff / (1000 * 60 * 60));
            const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((diff % (1000 * 60)) / 1000);
            
            document.getElementById('hours').textContent = String(hours).padStart(2, '0');
            document.getElementById('minutes').textContent = String(minutes).padStart(2, '0');
            document.getElementById('seconds').textContent = String(seconds).padStart(2, '0');
        }
        
        setInterval(updateTimer, 1000);
        updateTimer();

        // Günlük bonus al
        function claimDailyBonus() {
            const btn = event.target;
            btn.disabled = true;
            btn.textContent = '✓ Bonus Alındı!';
            
            // Bugünkü günü işaretle
            const today = document.querySelector('.streak-day.today');
            if (today) {
                today.classList.add('claimed');
            }
            
            alert('Tebrikler! 150 bi! kazandınız!');
        }

        // Görev ödülü al
        function claimReward(btn, amount) {
            btn.disabled = true;
            btn.classList.add('claimed');
            btn.textContent = 'Alındı ✓';
            
            const card = btn.closest('.mission-card');
            card.classList.add('claimed');
            
            alert('Tebrikler! ' + amount + ' bi! kazandınız!');
        }
    </script>
